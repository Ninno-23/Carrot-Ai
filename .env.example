# ============================================================
# Carrot AI — environment variables
# NEVER commit a real .env file. Keys stay on Render / local only.
# ============================================================
# Local:  cp .env.example .env   then paste your real key into .env
# Render: Dashboard → Environment → add the same keys

# --- Chat (Hugging Face router — works on Wi‑Fi or mobile data) ---
AI_API_URL=https://router.huggingface.co/v1/chat/completions
AI_API_KEY=your_huggingface_token_here
AI_MODEL=Qwen/Qwen2.5-7B-Instruct

# --- Images (same HF token works) ---
# Free token: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here
IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
IMAGE_API_URL=
IMAGE_API_KEY=

# --- Optional ---
ENABLE_CORS=false
CORS_ORIGINS=
LOG_LEVEL=INFO
PORT=5000
